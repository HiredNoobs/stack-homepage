  - qBittorrent:
      href: https://qbittorrent.$DOMAIN
      icon: qbittorrent
      widget:
        type: qbittorrent
        url: http://192.168.111.6:8080
        username: $QBITTORRENT_USER
        password: $QBITTORRENT_PASS
        enableLeechProgress: true
        enableLeechSize: true

