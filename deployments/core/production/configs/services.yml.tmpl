# href is opened in the browser, so it uses the $DOMAIN names (through nginx). A widget's url is
# called from the homepage pod where $DOMAIN doesn't resolve, so it goes straight to the upstream,
# the same ones as NGINX_SERVICES in stack-nginx. Self-signed certs are accepted.

- Infra:
  - Router:
      href: https://router.$DOMAIN
      icon: router
  - Proxmox:
      href: https://proxmox.$DOMAIN
      icon: proxmox
      widget:
        type: proxmox
        url: https://192.168.111.2:8006
        username: $PROXMOX_API_USER
        password: $PROXMOX_API_PASS
  - NAS:
      href: https://nas.$DOMAIN
      icon: ugreen
  # One app password (PIHOLE_API_APP_PWHASH in stack-pihole) is shared by every replica.
  - Pi-hole 1:
      href: https://pihole1.$DOMAIN/admin
      icon: pi-hole
      widget:
        type: pihole
        url: https://pihole-0.pihole.pihole-core.svc.cluster.local
        version: 6
        key: $PIHOLE_API_KEY
  - Pi-hole 2:
      href: https://pihole2.$DOMAIN/admin
      icon: pi-hole
      widget:
        type: pihole
        url: https://pihole-1.pihole.pihole-core.svc.cluster.local
        version: 6
        key: $PIHOLE_API_KEY
  - Pi-hole 3:
      href: https://pihole3.$DOMAIN/admin
      icon: pi-hole
      widget:
        type: pihole
        url: https://pihole-2.pihole.pihole-core.svc.cluster.local
        version: 6
        key: $PIHOLE_API_KEY

- Monitoring:
  - Grafana:
      href: https://grafana.$DOMAIN
      icon: grafana
      widget:
        type: grafana
        version: 2
        alerts: alertmanager
        url: https://grafana.grafana-core.svc.cluster.local:3000
        username: $GRAFANA_USER
        password: $GRAFANA_PASS
  - VictoriaLogs:
      href: https://victorialogs.$DOMAIN
      icon: victorialogs
  - VictoriaMetrics:
      href: https://victoriametrics.$DOMAIN
      icon: victoriametrics
  - VMAlert:
      href: https://vmalert.$DOMAIN
      icon: victoriametrics
  - VMAgent:
      href: https://vmagent.$DOMAIN
      icon: victoriametrics
  - Alertmanager:
      href: https://alertmanager.$DOMAIN
      icon: alertmanager

- Services:
  - Vaultwarden:
      href: https://vaultwarden.$DOMAIN
      icon: vaultwarden
  - Vault:
      href: https://vault.$DOMAIN
      icon: vault
  - RabbitMQ:
      href: https://rabbitmq.$DOMAIN
